# Base de datos (Neon - Postgres)
# Rellena con tu connection string de Neon (sin las comillas).
# IMPORTANTE para Neon: usa la conexión "pooled" (con -pooler) para la app.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js - secreto para firmar sesiones (JWT)
# Genera uno con: npx auth secret
AUTH_SECRET=""

# Credenciales del usuario admin inicial (solo usadas por el seed)
# REQUERIDAS: el seed falla si no están definidas.
ADMIN_EMAIL="admin@balkran.com"
ADMIN_PASSWORD=""

# URL base del sitio (para producción)
AUTH_URL="http://localhost:3000"
# Dominio canónico público (para sitemap, canonical y Open Graph). Ej: https://balkran.com
NEXT_PUBLIC_SITE_URL=""

# Resend (envío de correos para recuperación de contraseña)
# Obtén una key en https://resend.com/api-keys
RESEND_API_KEY=""
# Correo "from". Para probar usa: Balkran <onboarding@resend.dev>
# En producción verifica tu dominio en https://resend.com/domains y usa: Balkran <no-reply@tu-dominio.com>
EMAIL_FROM="Balkran <onboarding@resend.dev>"

# Cloudflare R2 (almacenamiento de imágenes)
# Crea un bucket en dash.cloudflare.com → R2 → Create bucket (ej: balkran-images)
# Luego R2 → Manage R2 API Tokens → token con permiso "Object Read & Write"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="balkran-images"
# URL pública del bucket (R2 → bucket → Settings → Public access). Dejar vacío si no se activa.
R2_PUBLIC_URL=""

# Groq (asistente Volt) — gratis en https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Cloudflare Turnstile (protección de formularios contra bots: login, recuperación, chat)
# Crea un sitio en https://dash.cloudflare.com → Turnstile → Add site
# NEXT_PUBLIC_TURNSTILE_SITE_KEY (pública, va al navegador) y TURNSTILE_SECRET_KEY (privada, servidor)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
